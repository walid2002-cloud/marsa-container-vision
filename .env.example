# Exemple de variables d'environnement — copier vers .env et adapter

MYSQL_ROOT_PASSWORD=marsa_root_2026
MYSQL_DATABASE=marsa_container_db
MYSQL_USER=marsa_user
MYSQL_PASSWORD=marsa_pass_2026

JWT_SECRET=marsa_jwt_secret_2026
INTEGRATION_API_KEY=marsa-integration-2026-secret

DETECTION_MODE=demo
DETECTION_CONFIDENCE_THRESHOLD=0.35

# Marsa Maroc AI (bot WhatsApp / intégration)
MARSA_AI_URL=http://localhost:5173
# UN seul ngrok : backend Marsa :3000 (proxy /ai/results → host.docker.internal:5080). Pas de tunnel 5080.
INTEGRATION_PUBLIC_BASE_URL=https://unslouchy-moira-parasynthetic.ngrok-free.dev
# Ping santé depuis le conteneur backend (Docker Desktop)
MARSA_AI_HEALTH_URL=http://host.docker.internal:5173

# Chiffrement identifiants RTSP (AES-256-GCM, fallback JWT_SECRET)
CAMERA_CREDENTIALS_KEY=

# Origines CORS autorisées pour le backend (séparées par des virgules)
CORS_ORIGINS=http://localhost:5080,http://localhost:5173

# === Phase 4 : Notifications multi-canal ===
# Générales
NOTIFICATIONS_ENABLED=true
NOTIFICATION_SIMULATION_MODE=true
NOTIFICATION_MIN_RESEND_MINUTES=60

# WhatsApp (Meta Cloud API) — laisser en simulation en dev
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_PROVIDER=simulation
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_RECIPIENT=+212600000000

# Email (SMTP) — laisser en simulation en dev
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=simulation
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Marsa Container Vision <no-reply@marsamaroc.local>
EMAIL_DEFAULT_RECIPIENT=ops@marsamaroc.local

# SMS — simulation (aucun fournisseur réel par défaut)
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=simulation
SMS_DEFAULT_RECIPIENT=+212600000000

# Seuils alertes (Phase 3)
STALE_POSITION_HOURS=24
IMMOBILIZED_HOURS=2
