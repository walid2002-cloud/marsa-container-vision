# Mode de détection : "mock" | "demo" | "real"
DETECTION_MODE=demo

# Dossier de stockage des images de preuve
EVIDENCE_DIR=./evidence

# --- OCR (Phase 5) ---
# Largeur max de redimensionnement avant OCR (préserve le ratio)
OCR_PREPROCESS_MAX_WIDTH=1600
# Seuils de matching flou
ISO_FUZZY_MIN_SIM=0.85
NUM_FUZZY_MIN_SIM=0.80

# --- YOLO (Phase 5 : préparation modèle conteneurs) ---
# Active/désactive l'inférence YOLO (OCR seul si false)
YOLO_ENABLED=false
# experimental (COCO yolov8n) | custom (modèle conteneurs entraîné)
YOLO_MODEL_MODE=experimental
# Chemin du modèle custom .pt (requis si YOLO_MODEL_MODE=custom)
YOLO_MODEL_PATH=
# Seuil de confiance YOLO
YOLO_CONFIDENCE_THRESHOLD=0.28
# Fichier de classes du dataset (format Ultralytics)
YOLO_CLASSES_CONFIG=/app/dataset/dataset.yaml
