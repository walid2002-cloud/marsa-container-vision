# Configuration du backend
NODE_ENV=development
PORT=3001

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=marsa_user
DB_PASSWORD=marsa_pass_2026
DB_NAME=marsa_container_db

# JWT / Authentification
JWT_SECRET=marsa_jwt_secret_2026
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_SECRET=marsa_refresh_secret_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Phase 6 — Sécurité avancée (RBAC, MFA, audit, rate-limit)
MFA_ISSUER=Marsa Container Vision
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUDIT_LOGS_ENABLED=true
RBAC_ENABLED=true
SUPER_ADMIN_EMAIL=admin@marsamaroc.com

# URL du service IA
AI_SERVICE_URL=http://localhost:8001

# Phase 7 — API d'intégration + URLs publiques (preuves, carte, dashboard)
INTEGRATION_API_KEY=marsa-integration-2026-secret
# URL publique UI Container Vision (navigateur, carte, fiche conteneur)
PUBLIC_APP_URL=http://localhost:5080
PUBLIC_BASE_URL=
# Tunnel ngrok direct sur CV (5080) — optionnel, prioritaire pour getPublicBase() si défini
NGROK_URL=
# Preuves WhatsApp via Marsa Maroc AI : UN seul tunnel ngrok → backend Marsa :3000
# (Marsa proxifie /ai/results/* vers host.docker.internal:5080). Ne pas mettre l'URL 5080 ici.
# Exemple : https://xxxx.ngrok-free.dev
INTEGRATION_PUBLIC_BASE_URL=
# Alias acceptés : MARSA_PUBLIC_PROXY_URL, MARSA_PUBLIC_URL
